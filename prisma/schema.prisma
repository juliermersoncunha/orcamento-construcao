generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectType {
  NOVA_CONSTRUCAO
  REFORMA
  AMPLIACAO
}

enum ProjectStatus {
  RASCUNHO
  FINALIZADO
  ENVIADO
}

enum PhaseType {
  TERRAPLENAGEM
  FUNDACAO
  ESTRUTURA_ALVENARIA
  LAJE
  INSTALACOES_ELETRICAS
  INSTALACOES_HIDROSSANITARIAS
  ESCADA
  REVESTIMENTOS
  PINTURA
  COBERTURA
  ACABAMENTO
  OUTROS
}

enum LaborModel {
  FIXED
  PER_M2
  PERCENT
}

enum MaterialCategory {
  TERRAPLENAGEM
  FUNDACAO
  LAJE
  PINTURA
  ACABAMENTO
  ESTRUTURA
  ALVENARIA
  COBERTURA
  ELETRICA
  HIDRAULICA
  REVESTIMENTO
  ESQUADRIA
  LOUCAS_SANITARIAS
  METAIS_SANITARIOS
  ACESSORIOS_HIDRAULICOS
  IMPERMEABILIZACAO
  VIDROS_BOX
  ACESSORIOS_BANHEIRO
  OUTROS
}

enum RoomType {
  BANHEIRO
  LAVABO
  BANHEIRO_SUITE
  BANHEIRO_SERVICO
  COZINHA
  AREA_SERVICO
  QUARTO
  SUITE
  SALA_ESTAR
  SALA_JANTAR
  GARAGEM
  VARANDA
  ESCRITORIO
  CIRCULACAO
  OUTRO
}

enum FixtureType {
  VASO_CAIXA_ACOPLADA
  VASO_VALVULA
  LAVATORIO_SUSPENSO
  LAVATORIO_COLUNA
  CUBA_APOIO
  CUBA_EMBUTIR
  CUBA_SOBREPOR
  GABINETE_CUBA
  BANCADA_CUBA
  CHUVEIRO_ELETRICO
  DUCHA_FRIA
  DUCHA_QUENTE
  DUCHA_SOLAR
  DUCHA_GAS
  CAIXA_SIFONADA
  RALO_SIFONADO
  RALO_SECO
  RALO_LINEAR
  DUCHA_HIGIENICA
  BOX_FRONTAL
  BOX_CANTO
  EXAUSTOR
  TORNEIRA_ELETRICA
}

enum HydraulicPointType {
  AGUA_FRIA
  AGUA_QUENTE
  ESGOTO_40
  ESGOTO_50
  ESGOTO_100
  RALO
}

enum ElectricalPointType {
  TOMADA
  INTERRUPTOR
  PONTO_LUZ
  CIRCUITO_EXCLUSIVO
}

enum JoineryType {
  PORTA_INTERNA
  PORTA_EXTERNA
  JANELA
}

enum ImpermScope {
  NENHUM
  BOX
  PISO
  PISO_PAREDES
  CUSTOM
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(MEMBER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects     Project[]
  priceChanges PriceHistory[]
}

model Project {
  id           String        @id @default(cuid())
  name         String
  clientName   String
  clientPhone  String?
  clientEmail  String?
  address      String?
  city         String?
  state        String?
  type         ProjectType
  status       ProjectStatus @default(RASCUNHO)
  notes        String?
  wizardStep   Int           @default(1)
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user          User                  @relation(fields: [userId], references: [id])
  rooms         Room[]
  structure     ProjectStructure?
  roofing       ProjectRoofing?
  installations ProjectInstallations?
  finishes      ProjectFinishes?
  budgetItems   BudgetItem[]
  laborConfig     LaborConfig?
  cashFlowEntries CashFlowEntry[]
  walls           ProjectWall[]
  indirectCosts   IndirectCost[]
  viability       ProjectViability?
}

model Room {
  id        String    @id @default(cuid())
  projectId String
  name      String
  width     Float
  length    Float
  height    Float     @default(2.8)
  order     Int       @default(0)
  roomType  RoomType?

  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  electricalPoints ElectricalPoint[]
  hydraulicPoints  HydraulicPoint[]
  roomFinishes     RoomFinish[]
  fixtures         Fixture[]
  wallFinishes     RoomWallFinish[]
  joineries        RoomJoinery[]
  accessories      Accessory[]
  imperm           RoomImpermeabilization?
}

model ProjectStructure {
  id             String  @id @default(cuid())
  projectId      String  @unique
  foundationType String  @default("sapata_corrida")
  structureType  String  @default("concreto_armado")
  blockType      String  @default("tijolo_furado")
  floors         Int     @default(1)
  hasLaje        Boolean @default(false)
  hasEscada      Boolean @default(false)

  // Pilares — metros lineares e seção
  pilarMetros    Float   @default(0)
  pilarLargura   Float   @default(0.15)
  pilarAltura    Float   @default(0.30)

  // Vigas — metros lineares e seção
  vigaMetros     Float   @default(0)
  vigaLargura    Float   @default(0.15)
  vigaAltura     Float   @default(0.40)

  // Sapatas — quantidade e dimensões
  sapataQtd      Int     @default(0)
  sapataLargura  Float   @default(0.60)
  sapataCompr    Float   @default(0.60)
  sapataAltura   Float   @default(0.30)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectRoofing {
  id          String  @id @default(cuid())
  projectId   String  @unique
  roofType    String  @default("duas_aguas")
  tileType    String  @default("ceramica")
  inclination Float   @default(30)
  hasRoof     Boolean @default(true)
  // Fibrocimento: "2,44 x 1,1" | "1,83 x 1,1". Define a área útil e o material.
  tileSize    String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectInstallations {
  id          String @id @default(cuid())
  projectId   String @unique
  heatingType String @default("eletrico")

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  electricalPoints ElectricalPoint[]
  hydraulicPoints  HydraulicPoint[]
}

model ElectricalPoint {
  id              String @id @default(cuid())
  installationsId String
  roomId          String
  outlets         Int    @default(2)
  switches        Int    @default(1)
  lightPoints     Int    @default(1)

  installations ProjectInstallations      @relation(fields: [installationsId], references: [id], onDelete: Cascade)
  room          Room                      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  details       ElectricalPointDetail[]
}

model HydraulicPoint {
  id              String @id @default(cuid())
  installationsId String
  roomId          String
  waterInlets     Int    @default(0)
  drainPoints     Int    @default(0)

  installations ProjectInstallations     @relation(fields: [installationsId], references: [id], onDelete: Cascade)
  room          Room                     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  details       HydraulicPointDetail[]
}

model HydraulicPointDetail {
  id               String             @id @default(cuid())
  hydraulicPointId String
  type             HydraulicPointType
  quantity         Int                @default(0)
  sourceFixtureId  String?

  hydraulicPoint HydraulicPoint @relation(fields: [hydraulicPointId], references: [id], onDelete: Cascade)
}

model ElectricalPointDetail {
  id                String              @id @default(cuid())
  electricalPointId String
  type              ElectricalPointType
  quantity          Int                 @default(0)
  sourceFixtureId   String?

  electricalPoint ElectricalPoint @relation(fields: [electricalPointId], references: [id], onDelete: Cascade)
}

model Fixture {
  id                 String      @id @default(cuid())
  roomId             String
  fixtureType        FixtureType
  quantity           Int         @default(1)
  exclusionGroup     String?
  configJson         String?
  includedComponents String[]    @default([])
  createdAt          DateTime    @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model RoomWallFinish {
  id         String  @id @default(cuid())
  roomId     String
  wallSide   String
  hasTile    Boolean @default(false)
  tileHeight Float   @default(1.5)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model RoomImpermeabilization {
  id             String      @id @default(cuid())
  roomId         String      @unique
  scope          ImpermScope @default(NENHUM)
  area           Float       @default(0)
  wallHeight     Float       @default(0)
  ralos          Int         @default(0)
  tubulacoes     Int         @default(0)
  system         String      @default("argamassa_polimerica")
  coats          Int         @default(3)
  mechProtection Boolean     @default(false)

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model RoomJoinery {
  id                 String      @id @default(cuid())
  roomId             String
  joineryType        JoineryType
  subtype            String      @default("comum")
  width              Float       @default(0.80)
  height             Float       @default(2.10)
  material           String      @default("madeira")
  quantity           Int         @default(1)
  prefinished        Boolean     @default(false)
  includedComponents String[]    @default([])
  configJson         String?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Accessory {
  id            String  @id @default(cuid())
  roomId        String
  accessoryType String
  quantity      Int     @default(1)
  // Dimensions/options for accessories that have them (espelho, gabinete, nicho…),
  // shaped by the accessory's configSchema in the fixture library.
  configJson    String?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model ProjectFinishes {
  id            String @id @default(cuid())
  projectId     String @unique
  doors         Int    @default(0)
  windows       Int    @default(0)
  externalDoors Int    @default(1)

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roomFinishes RoomFinish[]
}

model RoomFinish {
  id             String  @id @default(cuid())
  finishesId     String
  roomId         String
  floorType      String  @default("ceramica")
  wallTile       Boolean @default(false)
  wallTileHeight Float   @default(1.5)
  paintWalls     Boolean @default(true)

  finishes ProjectFinishes @relation(fields: [finishesId], references: [id], onDelete: Cascade)
  room     Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Material {
  id           String           @id @default(cuid())
  name         String
  unit         String
  category     MaterialCategory
  currentPrice Float
  priceDate    DateTime?
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  priceHistory PriceHistory[]
  budgetItems  BudgetItem[]
}

model PriceHistory {
  id         String   @id @default(cuid())
  materialId String
  price      Float
  changedAt  DateTime @default(now())
  changedBy  String

  material Material @relation(fields: [materialId], references: [id])
  user     User     @relation(fields: [changedBy], references: [id])
}

model BudgetItem {
  id                String    @id @default(cuid())
  projectId         String
  materialId        String
  phase             PhaseType
  quantity          Float
  unitPriceSnapshot Float
  createdAt         DateTime  @default(now())

  // Origin metadata — populated for items generated by the fixture library.
  // NULL for the classic per-phase items (structure, roofing, …), which keeps
  // the existing report and calculations unchanged.
  roomId            String?   // ambiente de origem (visão por ambiente)
  sourceKind        String?   // FIXTURE | JOINERY | ACCESSORY | IMPERM | GENERIC
  sourceLabel       String?   // equipamento que originou o item
  formula           String?   // memória de cálculo
  autoGenerated     Boolean   @default(true)

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])
}

model LaborConfig {
  id        String     @id @default(cuid())
  projectId String     @unique
  model     LaborModel @default(PERCENT)

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phases  LaborPhase[]
}

model LaborPhase {
  id            String    @id @default(cuid())
  laborConfigId String
  phase         PhaseType
  value         Float

  laborConfig LaborConfig @relation(fields: [laborConfigId], references: [id], onDelete: Cascade)
}

model CashFlowEntry {
  id        String    @id @default(cuid())
  projectId String
  phase     PhaseType
  month     Int
  percent   Float

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Premissas globais de cálculo (coeficientes editáveis pelo admin)
model GlobalPremise {
  id       String @id @default(cuid())
  key      String @unique
  label    String
  value    Float
  unit     String
  category String
}

// Muros por lado do terreno
model ProjectWall {
  id        String  @id @default(cuid())
  projectId String
  side      String  // FRONT | BACK | LEFT | RIGHT
  hasWall   Boolean @default(false)
  length    Float   @default(0)
  height    Float   @default(2.0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Custos indiretos e extras por projeto
model IndirectCost {
  id        String @id @default(cuid())
  projectId String
  label     String
  category  String // PROJETO | REGULARIZACAO | AVERBACAO | OUTROS
  value     Float

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Viabilidade financeira do projeto
model ProjectViability {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  // construção
  salePrice          Float    @default(0)
  bdiPercent         Float    @default(0)
  notes              String?
  updatedAt          DateTime @updatedAt
  // terreno
  landValue          Float    @default(0)
  landAppraisalValue Float    @default(0)
  itivPercent        Float    @default(2)
  landDocPercent     Float    @default(3.65)
  // venda
  hasSale            Boolean  @default(false)
  venalValue         Float    @default(0)
  saleDocPercent     Float    @default(7.5)
  brokeragePercent   Float    @default(5)
  irPercent          Float    @default(15)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
